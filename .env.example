# MTANDT Enterprise Platform — backend environment template.
# Copy to .env and fill in real values.
NODE_ENV=development
PORT=4200
API_PREFIX=/api/v1

# Public base URL of this API as the browser sees it (no trailing slash).
# Used for absolute <video>/<iframe> stream URLs when FE and API are on different hosts.
# Leave empty in local dev when Vite proxies /api → backend (relative URLs work).
# Example production: https://api.example.com
PUBLIC_API_URL=

# PostgreSQL connection string (e.g. your Render Postgres URL). URL-encode special
# chars in the password (e.g. '@' → %40).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# JWT secrets — MUST be long, random, and different from each other in production.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Frontend origin(s) for CORS (comma-separated). Set to your deployed frontend URL.
CORS_ORIGIN=https://your-frontend-domain.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=100

REFRESH_COOKIE_NAME=mtandt_refresh

# ── Email / SMTP (password-reset OTP) ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MTANDT Platform <no-reply@mtandt.com>
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
APP_URL=https://your-frontend-domain.com

# ── Cloudflare R2 (required for durable media storage) ────────────────────────
# Create a bucket in Cloudflare Dashboard → R2 → Create bucket.
# Create an API token with Object Read & Write permissions for that bucket.
# Account ID is shown on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mtandt-platform-media
# Optional: public base URL if you attach a custom domain (not needed for private streaming via API).
# R2_PUBLIC_URL=https://media.example.com

# Media token + upload limits
# MEDIA_TOKEN_SECRET=change-me-media
# MEDIA_TOKEN_TTL=3h
# MAX_UPLOAD_MB=500
