// ============================================================================
// MTANDT Enterprise Platform — Prisma schema (PostgreSQL)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum GrantEffect {
  ALLOW
  DENY
}

enum NotificationType {
  SYSTEM
  ACCOUNT
  ACCESS
  ANNOUNCEMENT
  ALERT
  NEW_COURSE
  TRAINING_ASSIGNMENT
  QUIZ_DUE
  CERTIFICATE
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model User {
  id           String     @id @default(uuid())
  employeeId   String?    @unique
  name         String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  designation  String?
  phone        String?
  avatarUrl    String?
  bio          String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  userRoles       UserRole[]       @relation("UserRoleUser")
  rolesAssigned   UserRole[]       @relation("UserRoleAssignedBy")
  userPermissions UserPermission[] @relation("UserPermissionUser")
  permsAssigned   UserPermission[] @relation("UserPermissionAssignedBy")

  managedDepartments  Department[]         @relation("DepartmentManager")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  filesUploaded       File[]               @relation("FileUploadedBy")

  coursesInstructing       Course[]          @relation("CourseInstructor")
  coursesCreated           Course[]          @relation("CourseCreator")
  enrollments              Enrollment[]      @relation("UserEnrollments")
  assignedEnrollments      Enrollment[]      @relation("AssignedEnrollments")
  lessonProgress           LessonProgress[]
  quizAttempts             QuizAttempt[]
  quizzesCreated           Quiz[]
  certificates             Certificate[]
  downloadRequests         DownloadRequest[] @relation("UserDownloadRequests")
  reviewedDownloadRequests DownloadRequest[] @relation("ReviewedDownloadRequests")

  dashboardAccess      DashboardAccess[] @relation("DashboardAccessUser")
  dashboardAssignments DashboardAccess[] @relation("DashboardAccessAssignedBy")

  feedbackGiven    Feedback[] @relation("FeedbackGiven")
  feedbackReceived Feedback[] @relation("FeedbackReceived")

  @@index([departmentId])
  @@index([companyId])
  @@index([managerId])
  @@index([status])
  @@map("users")
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  departments Department[]
  users       User[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  code      String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  managerId String?
  manager   User?   @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  users User[] @relation("DepartmentMembers")

  @@index([managerId])
  @@index([companyId])
  @@map("departments")
}

model Role {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  moduleKey   String
  name        String
  description String?
  isSystem    Boolean @default(true)

  module          Module           @relation(fields: [moduleKey], references: [key], onDelete: Cascade)
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([moduleKey])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           String      @id @default(uuid())
  userId       String
  permissionId String
  effect       GrantEffect @default(ALLOW)
  assignedAt   DateTime    @default(now())
  assignedById String?

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy User?      @relation("UserPermissionAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model Module {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  path        String?
  color       String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isCore      Boolean  @default(false)
  // External apps (CRM/ERP/HCM): open `externalUrl` in a new tab instead of an
  // in-app route. Super admins set the URL; a card only appears once a URL is set.
  isExternal  Boolean  @default(false)
  externalUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]

  @@map("modules")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id          String      @id @default(uuid())
  action      String
  module      String
  status      AuditStatus @default(SUCCESS)
  description String?
  entityType  String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  browser     String?
  device      String?

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  userName  String?
  userRoles String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([status])
  @@map("audit_logs")
}

model File {
  id           String   @id @default(uuid())
  key          String   @unique
  originalName String
  mimeType     String
  sizeBytes    BigInt   @default(0)
  url          String
  isProtected  Boolean  @default(false)
  module       String?
  createdAt    DateTime @default(now())

  uploadedById String?
  uploadedBy   User?   @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
  @@map("files")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  RICH_TEXT
  VIDEO
  PDF
  DOCUMENT
  MIXED
}

enum EnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MULTIPLE_SELECT
  SCENARIO
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

enum DownloadRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses Course[]

  @@map("lms_categories")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  courses Course[]

  @@map("lms_tags")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String?
  summary          String?
  thumbnailUrl     String?
  bannerUrl        String?
  difficulty       Difficulty   @default(BEGINNER)
  estimatedMinutes Int          @default(0)
  status           CourseStatus @default(DRAFT)
  isFeatured       Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  instructorId String?
  instructor   User?   @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  sections     Section[]
  quizzes      Quiz[]
  enrollments  Enrollment[]
  certificates Certificate[]
  tags         Tag[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Section {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("sections")
}

model Lesson {
  id               String     @id @default(uuid())
  sectionId        String
  section          Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title            String
  type             LessonType @default(RICH_TEXT)
  content          String?
  notes            String?
  orderIndex       Int        @default(0)
  estimatedMinutes Int        @default(0)
  isPreview        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  video     Video?
  documents LessonDocument[]
  progress  LessonProgress[]

  @@index([sectionId])
  @@map("lessons")
}

model Video {
  id           String   @id @default(uuid())
  lessonId     String   @unique
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  url          String   @default("")
  fileKey      String?
  isProtected  Boolean  @default(false)
  mimeType     String?
  thumbnailUrl String?
  duration     Int      @default(0)
  sizeBytes    BigInt   @default(0)
  provider     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("videos")
}

model LessonDocument {
  id           String   @id @default(uuid())
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  url          String   @default("")
  fileKey      String?
  originalName String   @default("document")
  mimeType     String?
  sizeBytes    BigInt   @default(0)
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  downloadRequests DownloadRequest[]

  @@index([lessonId])
  @@map("lesson_documents")
}

/// Durable binary storage for protected uploads (videos/docs).
/// Survives ephemeral disks on Render — file bytes live in PostgreSQL.

model DownloadRequest {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation("UserDownloadRequests", fields: [userId], references: [id], onDelete: Cascade)
  documentId   String
  document     LessonDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status       DownloadRequestStatus @default(PENDING)
  reason       String?
  decisionNote String?
  reviewedById String?
  reviewedBy   User?                 @relation("ReviewedDownloadRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([userId])
  @@index([documentId])
  @@map("download_requests")
}

model Enrollment {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserEnrollments", fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ASSIGNED)
  progressPercent Float            @default(0)
  dueDate         DateTime?
  assignedAt      DateTime         @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  lastAccessedAt  DateTime?

  assignedById String?
  assignedBy   User?   @relation("AssignedEnrollments", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed           Boolean   @default(false)
  watchedSeconds      Int       @default(0)
  watchPercent        Float     @default(0)
  lastPositionSeconds Int       @default(0)
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id              String   @id @default(uuid())
  title           String
  description     String?
  passPercentage  Int      @default(70)
  durationMinutes Int?
  randomize       Boolean  @default(false)
  maxAttempts     Int?
  showAnswers     Boolean  @default(true)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type        QuestionType @default(MCQ)
  text        String
  explanation String?
  points      Int          @default(1)
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  options QuestionOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)

  @@index([questionId])
  @@map("question_options")
}

model QuizAttempt {
  id              String        @id @default(uuid())
  quizId          String
  quiz            Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          AttemptStatus @default(IN_PROGRESS)
  score           Float         @default(0)
  passed          Boolean       @default(false)
  durationSeconds Int           @default(0)
  startedAt       DateTime      @default(now())
  submittedAt     DateTime?

  answers QuizAnswer[]

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id                String      @id @default(uuid())
  attemptId         String
  attempt           QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]
  isCorrect         Boolean     @default(false)
  pointsAwarded     Float       @default(0)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

model Certificate {
  id             String   @id @default(uuid())
  certificateNo  String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completionDate DateTime @default(now())
  issuedAt       DateTime @default(now())
  qrData         String?
  pdfUrl         String?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([issuedAt])
  @@map("certificates")
}

model Dashboard {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  category    String?
  icon        String?
  color       String?

  secureEmbedUrl String?
  workspaceId    String?
  reportId       String?
  datasetId      String?
  embedUrl       String?

  isActive    Boolean  @default(true)
  allowExport Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  access DashboardAccess[]

  @@map("dashboards")
}

model DashboardAccess {
  id           String   @id @default(uuid())
  userId       String
  dashboardId  String
  assignedAt   DateTime @default(now())
  assignedById String?

  user       User      @relation("DashboardAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  dashboard  Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  assignedBy User?     @relation("DashboardAccessAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, dashboardId])
  @@index([userId])
  @@index([dashboardId])
  @@map("dashboard_access")
}

model Competency {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores FeedbackScore[]

  @@map("feedback_competencies")
}

model Feedback {
  id          String   @id @default(uuid())
  giverId     String
  giver       User     @relation("FeedbackGiven", fields: [giverId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("FeedbackReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  isAnonymous Boolean  @default(false)
  comment     String?
  periodMonth String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores FeedbackScore[]

  @@unique([giverId, recipientId, periodMonth])
  @@index([recipientId])
  @@index([giverId])
  @@map("feedback")
}

model FeedbackScore {
  id           String     @id @default(uuid())
  feedbackId   String
  feedback     Feedback   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  rating       Int

  @@unique([feedbackId, competencyId])
  @@index([competencyId])
  @@map("feedback_scores")
}
